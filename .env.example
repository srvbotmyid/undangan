PORT=3000
ADMIN_PASSWORD=ganti-password-kuat-disini
PUBLIC_BASE_URL=https://domain-kamu.id
DB_PATH=./data/guestbook.sqlite
# Token untuk agent. Kosongkan kalau MCP tidak dipakai.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=
# Mayar.id Headless API. Jangan commit key sungguhan.
# Production: https://api.mayar.id/hl/v2   Sandbox: https://api.mayar.io/hl/v2
MAYAR_API_KEY=
MAYAR_BASE_URL=https://api.mayar.id/hl/v2
# Opsional, hanya untuk uji coba. Contoh 1000. Hapus setelah tes.
MAYAR_TEST_AMOUNT=
# Bot Telegram. Bisa juga diisi dari panel admin.
TELEGRAM_BOT_TOKEN=
# Boleh lebih dari satu, pisahkan koma.
TELEGRAM_CHAT_ID=

